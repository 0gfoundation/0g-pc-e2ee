# Compose variables for the staging gateway on tapp (GCP project pc-gateway-staging).
# Copied to ../.env by the deploy step, uploaded with the compose and MEASURED, so
# it is public by construction: nothing secret goes here, ever.

# Equal to `tapp-cli start-app --app-id`. Names the KMS-derived TLS key, so it
# must not change once a certificate has been issued for that key.
TAPP_APP_ID=pc-gateway-staging

# Same router and chain as the Phala staging gateway (deploy/phala/env/staging.env).
ZG_GATEWAY_ROUTER_URL=https://router-api-cloud-staging.0g.ai
ZG_GATEWAY_NETWORK=mainnet
ZG_GATEWAY_SEAL_MODELS=0gm-1.0-35b-a3b,glm-5.3,qwen3-embedding-8b,qwen3-embedding-0.6b,vela-2.0-9b

# For c3-standard-4 (16 GB), the staging shape: leaves room for tapp's RAM-overlay
# root filesystem, haproxy and slack. Re-derive on every resize.
GOMEMLIMIT=10GiB
