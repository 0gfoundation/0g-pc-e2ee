# Template for secrets.env, the gateway's env_file. The deploy pipeline writes the
# real file from its secret store just before start-app; it is never committed
# (*.env is ignored). tapp measures it and publishes its hash, not its contents.
#
# Hex, at least 32 bytes; the same value as the router's CLIENT_IP_HMAC_KEYS.
# Without it the router puts every gateway user in one rate-limit bucket.
ZG_GATEWAY_CLIENT_IP_KEY=
# The CORS allowlist. Secret because some of the sites in it are not public.
ZG_GATEWAY_ALLOWED_ORIGINS=
