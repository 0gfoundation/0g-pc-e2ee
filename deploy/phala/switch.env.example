# Config for switch.sh — copy to `switch.env` (git-ignored) and fill in.
#
#   cp switch.env.example switch.env
#   # edit switch.env, then:
#   ./switch.sh status
#
# switch.sh loads `switch.env` automatically. The real environment still wins,
# so `CF_API_TOKEN=other ./switch.sh …` overrides the file for a one-off.

# REQUIRED — Cloudflare API token that can edit DNS in the delegation zone.
# Scope it to the delegation zone only; it never needs access to the served
# zone (0g.ai). This is a secret — keep it in switch.env, which is git-ignored.
CF_API_TOKEN=

# Needed only by `./switch.sh setup` (the one-time static serving alias):
# the cluster's dstack gateway, i.e. whatever router-api-tee.0g.ai.integratenetwork.work
# currently points at. `setup` prints the current value if this is unset.
# GATEWAY_DOMAIN=_.<cluster>.phala.network

# dstack platform base domain. Set it to enable the per-side pre-switch probe:
# `switch b` will health-check https://<app_id_b>-443s.<PLATFORM_BASE>/healthz
# (which reaches side b directly by app-id, before any traffic is pointed at it)
# and refuse to switch if it is not healthy.
# PLATFORM_BASE=in1.phala.network

# The rest default to the current production deployment; uncomment to override.

# CF_ZONE=integratenetwork.work          # delegation zone (where the switch records live)
# DOMAIN=router-api-tee.0g.ai            # served hostname
# DELEGATION_ZONE=integratenetwork.work  # base delegation zone (defaults to CF_ZONE)
# SIDE_A_LABEL=a                         # side-a sub-zone label -> a.<DELEGATION_ZONE>
# SIDE_B_LABEL=b                         # side-b sub-zone label -> b.<DELEGATION_ZONE>
# TXT_PREFIX=_dstack-app-address         # app-address record prefix
# HEALTH_PATH=/healthz                   # public health path checked after a switch
# TTL=60                                 # CNAME TTL (seconds)
# VERIFY_RETRIES=10                      # post-switch health attempts
# VERIFY_INTERVAL=6                      # seconds between attempts
