# Config for switch.sh — copy to `switch.env` (git-ignored) and fill in.
#
#   cp switch.env.example switch.env
#   # edit switch.env, then:
#   ./switch.sh status
#
# switch.sh loads `switch.env` automatically. The real environment still wins,
# so `CF_API_TOKEN=other ./switch.sh …` overrides the file for a one-off.

# REQUIRED — Cloudflare API token that can edit DNS in the delegation zone.
# Scope it to the delegation zone only; it never needs access to the served
# zone (0g.ai). This is a secret — keep it in switch.env, which is git-ignored.
CF_API_TOKEN=

# dstack platform base domain — THE one place the cluster is named on the
# operator side (the CVMs take no cluster value from you; their compose derives
# it from the platform). Two things read it:
#   - the per-side pre-switch probe: `switch b` health-checks
#     https://<app_id_b>-443s.<PLATFORM_BASE>/readyz, which reaches side b
#     directly by app-id before any traffic is pointed at it, and refuses to
#     switch if it is not healthy;
#   - `./switch.sh setup`, which derives the static serving alias from it as
#     _.<PLATFORM_BASE>.
# Read <cluster> off a CVM's kms_info.gateway_app_url, not from memory.
# PLATFORM_BASE=in1.phala.network

# Only if you need to point the serving alias somewhere PLATFORM_BASE does not
# imply. `setup` refuses when the two name different clusters, and `status`
# warns if the live alias drifts from PLATFORM_BASE. With both unset, `setup`
# prints whatever the alias currently points at so you can pin it as-is.
# GATEWAY_DOMAIN=_.<cluster>.phala.network

# The rest default to the current production deployment; uncomment to override.

# CF_ZONE=integratenetwork.work          # delegation zone (where the switch records live)
# DOMAIN=router-api-tee.0g.ai            # served hostname
# DELEGATION_ZONE=integratenetwork.work  # base delegation zone (defaults to CF_ZONE)
# SIDE_A_LABEL=a                         # side-a sub-zone label -> a.<DELEGATION_ZONE>
# SIDE_B_LABEL=b                         # side-b sub-zone label -> b.<DELEGATION_ZONE>
# TXT_PREFIX=_dstack-app-address         # app-address record prefix
# HEALTH_PATH=/healthz                   # public health path checked after a switch
# TTL=60                                 # CNAME TTL (seconds)
# VERIFY_RETRIES=20                      # post-switch attempts; window must outlast the gateway route cache
# VERIFY_INTERVAL=6                      # seconds between attempts
# PROBE_RETRIES=30                       # pre-switch target-probe attempts before refusing to switch
# PROBE_INTERVAL=10                      # seconds between them; 30x10s ~= 5min, sized to a cold first warmer sweep
# PROBE_PATH=/readyz                     # standby gate: can it SERVE. /healthz would only say the process is up
