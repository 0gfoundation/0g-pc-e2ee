# Secrets for running deploy-side.sh and switch.sh locally — copy to `secrets.env`
# next to this file (git-ignored) and fill in. Both scripts load it after their
# config file (env/<target>.env); the real environment still wins over it.
#
#   cp secrets.env.example secrets.env
#   ./switch.sh --env-file env/staging.env status
#   ./deploy-side.sh b --env-file env/staging.env --compose … --dry-run
#
# GitHub cannot show an Environment secret back, so keep your own copy of each
# (a password manager). In the workflows these come from the dns-<target> /
# deploy-<target> Environments instead and this file is not used.
#
# Staging and mainnet differ here only if their tokens do; if so, keep one file
# per deployment and pick it with SECRETS_ENV=… .

# switch.sh: edits the switch records in the delegation zone.
CF_API_TOKEN=

# deploy-side.sh: the Phala Cloud API key (or rely on `phala login`) …
PHALA_CLOUD_API_KEY=
# … and the CVM's two secrets, encrypted to it at deploy time.
CLOUDFLARE_API_TOKEN=
ZG_PROM_REMOTE_WRITE_PASSWORD=
# … and CVM variables kept out of the repository: KEY=VALUE lines, as the
# deploy-<target> secret of the same name holds them. One line here needs $'…'
# for the newlines between entries, e.g. on staging:
# CVM_SECRET_ENV=$'ZG_GATEWAY_ROUTER_URL=https://<staging router>'
CVM_SECRET_ENV=
