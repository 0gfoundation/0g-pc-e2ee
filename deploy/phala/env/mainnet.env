# Config for the mainnet gateway (router-api.0g.ai): everything that is not a
# secret, read by deploy-side.sh and switch.sh, in the workflows and locally:
#
#   ./deploy-side.sh b --env-file env/mainnet.env --compose … [--dry-run]
#   CF_API_TOKEN=… ./switch.sh --env-file env/mainnet.env status
#
# Public on purpose: the hostnames and clusters are in public DNS, the CVM's shape
# and OS image in its public quote. Secrets never go here — they come from the
# environment (in GitHub, the dns-mainnet / deploy-mainnet Environments):
# CF_API_TOKEN (switch.sh), CLOUDFLARE_API_TOKEN, ZG_PROM_REMOTE_WRITE_URL,
# ZG_PROM_REMOTE_WRITE_USERNAME, ZG_PROM_REMOTE_WRITE_PASSWORD, PHALA_CLOUD_API_KEY
# (deploy-side.sh). deploy-side_test.sh (in CI) checks that.
#
# CHANGEME is a placeholder; deploy-side.sh refuses to run while one is left.
# A change here is a change to the next side deployed: running sides keep the
# environment they were created with (blue-green.md, "Changing the environment").

# --- where it serves (switch.sh and deploy-side.sh) ---------------------------
DOMAIN=router-api.0g.ai
CF_ZONE=integratenetwork.work
DELEGATION_ZONE=integratenetwork.work
# The main cluster, where sides a and b run: <cluster>.phala.network, read off a
# CVM's kms_info.gateway_app_url.
PLATFORM_BASE=dstack-pha-prod5.phala.network
# Only with a cold standby (side c) in another cluster:
# PLATFORM_BASE_COLD=

# --- the CVM (deploy-side.sh) ---------------------------------------------------
CVM_NAME_PREFIX=pc-gateway-mainnet
# 16 vCPU / 32 GiB: mainnet's intended shape, the one GOMEMLIMIT's default is
# sized for (README, "CVM shape"). `phala instance-types` lists the names. Without
# it the CLI picks tdx.small, 1 vCPU / 2 GiB.
PHALA_INSTANCE_TYPE=tdx.2xlarge
# The node, pinned to the cluster above: prod5 (prod9, in the same region, is
# another cluster). Its HashID, the form the API takes — node_id_hashid in
# `phala api /teepods/cvm-create-resources`; the 26 `phala nodes ls` shows is
# refused. If Phala ever re-registers the node, the id changes and the deploy
# fails at provision — look it up again.
PHALA_NODE_ID=node_aOwADKBd
# PHALA_NODE_ID_COLD=
# Pinned to the image the running sides use: pcverify accepts only audited images
# (client/evidence/osimages.json), so a newer one the CLI might pick on its own
# would fail verification until it is added there.
PHALA_OS_IMAGE=dstack-0.6.1

# --- the CVM's environment (deploy-side.sh) -------------------------------------
# The remote_write URL, username and password are secrets, not here.
ZG_PROM_ENV=mainnet
# Further keys for the CVM, as CVM_ENV_<KEY>=<value> (reaches it as <KEY>).
# Gateway overrides. Quoted: the scripts load this file through the shell.
CVM_ENV_ZG_GATEWAY_SEAL_MODELS='0gm-1.0-35b-a3b,glm-5.3,qwen3-embedding-8b,qwen3-embedding-0.6b'
# ZG_GATEWAY_ALLOWED_ORIGINS (the CORS allowlist) is a secret: some of the sites in
# it are not public. It comes from the ZG_GATEWAY_ALLOWED_ORIGINS secret (locally,
# CVM_ENV_ZG_GATEWAY_ALLOWED_ORIGINS in secrets.env) and is required, so a missing
# secret stops the deploy instead of the compose default taking over.
CVM_REQUIRED_KEYS=ZG_GATEWAY_ALLOWED_ORIGINS

# --- smoke test (workflow) ------------------------------------------------------
# SMOKE_SEALED_MODEL=
# SMOKE_PLAIN_MODEL=
