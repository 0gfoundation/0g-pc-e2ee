# Config for deploy.sh — copy to `deploy.env` (git-ignored) and fill in.
#
#   cp deploy.env.example deploy.env
#   # edit deploy.env, then:
#   ./deploy.sh preflight --side b
#
# deploy.sh loads `deploy.env` automatically. The real environment still wins,
# so `ACME_STAGING=true ./deploy.sh …` overrides the file for a one-off.
#
# These values are INPUTS TO WHAT IS MEASURED. The four ${…} names the compose
# interpolates are invisible to app_id (only the reference text is measured), but
# the allowed_envs LIST and the public_logs / public_sysinfo / public_tcbinfo /
# secure_time flags below all go into the app-compose — so two blue/green sides
# must set them identically, or they differ by more than the image digest and the
# comparison the switch rests on stops being meaningful.

# ---------------------------------------------------------------------------
# Cluster and domain
# ---------------------------------------------------------------------------
# The target cluster's dstack gateway. deploy.sh derives PLATFORM_BASE from it
# (same value without the `_.`), so a cluster move is this one line — set both
# and they are checked against each other rather than silently diverging.
GATEWAY_DOMAIN=_.dstack-pha-in2.phala.network

# The hostname we serve, and the zone the CVM's dstack-ingress may write into.
# The served zone itself (0g.ai) is never touched: its three CNAMEs point here
# once and never change.
# DOMAIN=router-api-tee.0g.ai
# DELEGATION_ZONE=integratenetwork.work
# SIDE_A_LABEL=a
# SIDE_B_LABEL=b

# ---------------------------------------------------------------------------
# Secrets (this file is git-ignored; keep it that way)
# ---------------------------------------------------------------------------
# REQUIRED — Cloudflare API token that can edit DNS in the delegation zone.
# Scope it to the delegation zone ONLY; it never needs access to the served
# zone. Same token switch.env uses (there it is called CF_API_TOKEN).
CLOUDFLARE_API_TOKEN=

# REQUIRED — where the in-CVM Prometheus agent ships metrics. ZG_PROM_ENV must
# be exactly `staging` or `mainnet`: it is stamped on every series as an
# external label, and it is how a shared store tells the two deployments apart.
ZG_PROM_ENV=
ZG_PROM_REMOTE_WRITE_URL=
ZG_PROM_REMOTE_WRITE_USERNAME=
ZG_PROM_REMOTE_WRITE_PASSWORD=

# ---------------------------------------------------------------------------
# CVM shape — read README "CVM shape — and the one setting that depends on it"
# ---------------------------------------------------------------------------
# No default on purpose. GOMEMLIMIT=24GiB is hardcoded in the compose and was
# derived by hand from a 32 GiB CVM; the in-flight cap is derived from that in
# turn. Nothing in the manifest can check the shape the CVM actually got, so
# letting the platform pick one would be a silent claim about memory it may not
# have. `phala instance-types cpu` lists what the target cluster offers.
INSTANCE_TYPE=

# Optional pins. Leave unset to let the platform choose; set them to make a
# deployment reproducible — OS_IMAGE especially, because the image's MRTD /
# RTMR1 / RTMR2 must have an entry in client/evidence/osimages.json or
# `pcverify -gateway` fails the os-image check for every user.
# `phala os-images --prod` and `phala nodes list` show what is available.
# OS_IMAGE=
# NODE_ID=
# DISK_SIZE=40G
# KMS=phala

# ---------------------------------------------------------------------------
# Measured app-compose flags — identical on both sides, or they are not
# comparable. deploy.sh's defaults are shown; uncomment only to change one.
# ---------------------------------------------------------------------------
# PUBLIC_LOGS=false      # container logs readable from outside the CVM. This one
#                        # handles sealed prompts, so: off.
# PUBLIC_SYSINFO=false   # nothing needs it
# PUBLIC_TCBINFO=true    # ON: pcverify fetches app-compose.json from the guest
#                        # agent through it. Off, code identity must be fed in by hand.
# SECURE_TIME=false
# LISTED=false           # whether the CVM is listed on Phala's public Trust Center

# ---------------------------------------------------------------------------
# Container environment
# ---------------------------------------------------------------------------
# `print`, not the upstream default `wait`: each side lives under its own
# delegation sub-zone while the served CNAMEs stay pinned at the base zone, so
# the default's strict one-hop pre-check never matches and the side would block
# until DNS_SETUP_TIMEOUT and restart without a certificate. See blue-green.md.
# DNS_SETUP_MODE=print

# Let's Encrypt staging CA. Set true when bringing a NEW hostname (or a new
# cluster) up: successful issuances count against 5 duplicate certificates per
# week per hostname, and every fresh CVM issues again from an empty cert volume.
# Staging certs are untrusted, so deploy.sh's `verify` adds
# -allow-untrusted-cert while this is true — smoke tests only.
# ACME_STAGING=false

# Router the gateway resolves providers through. Unset = 0G production.
# ZG_GATEWAY_ROUTER_URL=
# Browser origin allowlist (CORS). Unset = the compose default.
# ZG_GATEWAY_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Probe timing — same meaning as in switch.env
# ---------------------------------------------------------------------------
# The post-deploy gate is /readyz, which needs a cold warmer sweep to finish:
# every provider's quote DCAP-verified one at a time, collateral fetched cold,
# each on-chain signer read. Minutes, not one DNS TTL.
# PROBE_RETRIES=30
# PROBE_INTERVAL=10

# CVM name; deploy.sh defaults to 0g-pc-gateway-<side>.
# CVM_NAME=
