# Go build output (e.g. `go build ./cmd/gateway/` drops the binary here)
/client/gateway
/client/pcverify
/client/cmd/pcverify/pcverify
/client/cmd/gateway/gateway

# Env files: these carry the DNS API token for the TEE deployment (deploy/phala/),
# and this repository is public. Covers .env, prod.env and .env.production alike.
*.env
.env.*
!*.example
# …except the checked-in, secret-free deployment config. deploy-side_test.sh fails
# if a secret's key appears in one; keep tokens in the environment or a local
# switch.env / deploy.env, which stay ignored.
!/deploy/phala/env/*.env
